{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "android/**",
      "ios/**",
      "windows/**",
      "linux/**",
      "macos/**",
      "build/**",
      ".dart_tool/**",
      ".idea/**",
      "*.exe",
      "**/*.exe",
      "*.bat",
      "**/*.bat",
      "*.cmd",
      "**/*.cmd",
      "*.com",
      "**/*.com",
      "*.msi",
      "**/*.msi",
      "*.ps1",
      "**/*.ps1"
    ],
    "rewrites": [
      {
        "source": "/qr/**",
        "destination": "/mini-app.html"
      },
      {
        "source": "/**",
        "destination": "/profile-router.html"
      }
    ]
  }
}
